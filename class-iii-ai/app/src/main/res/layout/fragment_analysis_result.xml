<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_gradient"
            android:orientation="vertical"
            android:padding="24dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Analysis Complete"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvResultPatientName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Patient: Loading..."
                android:textColor="@color/white"
                android:textSize="14sp"
                android:alpha="0.9" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Heatmap Image -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="350dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_card_rounded"
                android:padding="4dp">
                
                <ImageView
                    android:id="@+id/ivResultImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />
                
                <ImageView
                    android:id="@+id/ivHeatmapOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:alpha="0.5" />
            </FrameLayout>

            <!-- Diagnosis Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_rounded"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Diagnosis"
                    android:textColor="@color/secondaryTextColor"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />
                
                <TextView
                    android:id="@+id/tvDiagnosis"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Class III Malocclusion"
                    android:textColor="@color/primaryTextColor"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Severity Score"
                            android:textColor="@color/secondaryTextColor"
                            android:textSize="12sp" />
                        <TextView
                            android:id="@+id/tvSeverityScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.0"
                            android:textColor="@color/blueColor"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                    
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Convexity Angle"
                            android:textColor="@color/secondaryTextColor"
                            android:textSize="12sp" />
                        <TextView
                            android:id="@+id/tvAngle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="165°"
                            android:textColor="#f59e0b"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Advanced ML Features Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_rounded"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Advanced AI Metrics"
                    android:textColor="@color/primaryTextColor"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />
                
                <TextView
                    android:id="@+id/tvAdvancedFeatures"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Waiting for AI Analysis..."
                    android:textColor="@color/secondaryTextColor"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>
            
            <!-- AI Clinical Reasoning Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_rounded"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI Clinical Reasoning"
                    android:textColor="@color/primaryColor"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />
                
                <TextView
                    android:id="@+id/tvClinicalReasoning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Processing multimodal data..."
                    android:textColor="@color/secondaryTextColor"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>
            
            <!-- Medical Recommendation Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_rounded"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Medical Recommendation"
                    android:textColor="@color/primaryTextColor"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />
                
                <TextView
                    android:id="@+id/tvRecommendation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Analyzing..."
                    android:textColor="@color/secondaryTextColor"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp"
                    android:lineSpacingExtra="4dp"/>
                    
                <Button
                    android:id="@+id/btnBookAppointment"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Book Doctor Appointment"
                    android:backgroundTint="@color/primaryColor"
                    android:textColor="@color/white"
                    android:visibility="gone"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnSimulate"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Simulate Treatment"
                android:backgroundTint="@color/blueColor"
                android:textColor="@color/white"
                android:layout_marginBottom="12dp"
                android:visibility="gone"/>
                
            <Button
                android:id="@+id/btnDownloadPdf"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Download PDF Report"
                android:backgroundTint="@color/greenColor"
                android:textColor="@color/white"
                android:layout_marginBottom="12dp"
                android:visibility="visible"/>
                
            <Button
                android:id="@+id/btnBackToDashboard"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Back to Dashboard"
                android:backgroundTint="@color/borderColor"
                android:textColor="@color/primaryTextColor" />

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
