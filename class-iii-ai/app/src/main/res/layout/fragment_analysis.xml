<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_gradient"
            android:padding="24dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI Analysis"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/white" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Front + lateral scan, landmark detection"
                android:textSize="14sp"
                android:textColor="@color/white"
                android:alpha="0.9" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_rounded"
            android:layout_margin="16dp"
            android:padding="16dp">

            <!-- Patient Selection -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Patient (Optional)"
                android:textColor="@color/primaryTextColor"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/spinnerPatients"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_card_rounded"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_card_rounded">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Frontal"
                        android:textColor="@color/secondaryTextColor"
                        android:textSize="12sp" />
                    <ImageView
                        android:id="@+id/ivThumbFrontal"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:scaleType="centerCrop"
                        android:background="#1e293b" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_card_rounded">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lateral"
                        android:textColor="@color/secondaryTextColor"
                        android:textSize="12sp" />
                    <ImageView
                        android:id="@+id/ivThumbLateral"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:scaleType="centerCrop"
                        android:background="#1e293b" />
                </LinearLayout>
            </LinearLayout>

            <RadioGroup
                android:id="@+id/rgCaptureMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">
                <RadioButton
                    android:id="@+id/rbFrontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Capture Frontal"
                    android:checked="true"
                    android:textColor="@color/primaryTextColor" />
                <RadioButton
                    android:id="@+id/rbLateral"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Capture Lateral"
                    android:textColor="@color/primaryTextColor"
                    android:layout_marginStart="16dp" />
            </RadioGroup>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="350dp"
                android:background="#020617"
                android:layout_marginBottom="8dp">
                
                <androidx.camera.view.PreviewView
                    android:id="@+id/viewFinder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
                    
                <!-- Ghost Camera Overlay -->
                <ImageView
                    android:id="@+id/ivGhostOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:alpha="0.4"
                    android:visibility="gone" />
                    
                <ImageView
                    android:id="@+id/ivPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:background="#020617" />
                    
                <com.classiiiai.app.FaceOverlayView
                    android:id="@+id/faceOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
                    
                <TextView
                    android:id="@+id/tvCameraGuide"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Front Face Guide\nCenter face • Neutral expression"
                    android:textColor="@color/white"
                    android:background="#88000000"
                    android:padding="8dp"
                    android:gravity="center"
                    android:layout_gravity="center" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/llCaptureControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">
                <Button
                    android:id="@+id/btnFlipCamera"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Flip Camera"
                    android:backgroundTint="@color/borderColor"
                    android:textColor="@color/primaryTextColor"
                    android:layout_marginEnd="4dp" />
                <Button
                    android:id="@+id/btnCapture"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Capture"
                    android:backgroundTint="@color/primaryColor"
                    android:textColor="@color/white"
                    android:layout_marginStart="4dp" />
            </LinearLayout>
            
            <Button
                android:id="@+id/btnGallery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Upload from Gallery"
                android:backgroundTint="@color/borderColor"
                android:textColor="@color/primaryTextColor"
                android:layout_marginTop="8dp" />
                
            <Button
                android:id="@+id/btnRetake"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Clear Selected Scan"
                android:backgroundTint="@color/errorColor"
                android:textColor="@color/white"
                android:layout_marginTop="8dp" />
        </LinearLayout>
        
        <Button
            android:id="@+id/btnAnalyze"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start AI Analysis"
            android:backgroundTint="@color/blueColor"
            android:textColor="@color/white"
            android:layout_margin="16dp"
            android:enabled="false"
            android:alpha="0.5" />
    </LinearLayout>
</ScrollView>
