<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_gradient"
            android:padding="24dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Treatment Simulator"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/white" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Interactive Jaw Morphing Visualization"
                android:textSize="14sp"
                android:textColor="@color/white"
                android:alpha="0.9" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_rounded"
            android:layout_margin="16dp"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Simulate Mandibular Advancement/Setback"
                android:textColor="@color/primaryTextColor"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="350dp"
                android:background="#020617"
                android:layout_marginBottom="16dp">
                
                <com.classiiiai.app.MorphImageView
                    android:id="@+id/ivMorphPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter" />
                    
                <TextView
                    android:id="@+id/tvSelectImage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap to select lateral profile"
                    android:textColor="@color/secondaryTextColor"
                    android:layout_gravity="center" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mandibular Position (mm)"
                android:textColor="@color/secondaryTextColor"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-10"
                    android:textColor="@color/primaryTextColor" />
                    
                <SeekBar
                    android:id="@+id/sbMorph"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:max="200"
                    android:progress="100" />
                    
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+10"
                    android:textColor="@color/primaryTextColor" />
            </LinearLayout>
            
            <TextView
                android:id="@+id/tvMorphValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Neutral (0mm)"
                android:textAlignment="center"
                android:textColor="@color/primaryColor"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />

        </LinearLayout>
        
        <Button
            android:id="@+id/btnReset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reset Simulator"
            android:backgroundTint="@color/borderColor"
            android:textColor="@color/primaryTextColor"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp" />
            
    </LinearLayout>
</ScrollView>
